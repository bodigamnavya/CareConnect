# CareConnect Environment Variables
# For Local Development & Render Production

# Flask Security
SECRET_KEY=CareConnect_Super_Secret_Production_Key_2026
JWT_SECRET=CareConnect_Secure_JWT_2026_Production_Key_987654
JWT_EXPIRATION_HOURS=48

# Database (PostgreSQL for Render/Supabase, or omit for SQLite local storage)
DATABASE_URL=
# Example: postgresql://user:password@localhost:5432/careconnect

# External AI Provider (Optional: Google Gemini or OpenAI API Key)
# If left empty, CareConnect uses its built-in clinical intelligence heuristics model
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# CORS Allowed Origin (set your Vercel URL in production, e.g. https://careconnect.vercel.app)
FRONTEND_URL=*
PORT=5000
