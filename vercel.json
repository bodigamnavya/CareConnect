{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/db-health",
      "destination": "/api/index.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/CSS/(.*)",
      "destination": "/frontend/CSS/$1"
    },
    {
      "source": "/JS/(.*)",
      "destination": "/frontend/JS/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*\\.html)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|gif|svg|ico|css|js|webp))",
      "destination": "/frontend/$1"
    }
  ]
}
