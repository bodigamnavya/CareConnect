# CareConnect Production & Local Environment Variables
# ----------------------------------------------------

# MongoDB Atlas (Production & Development Database)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=careconnect

# Authentication & Security
SECRET_KEY=CareConnect_Super_Secret_Production_Key_2026
JWT_SECRET=CareConnect_Secure_JWT_2026_Production_Key_987654
JWT_EXPIRATION_HOURS=48

# CORS Allowed Origin (e.g. https://careconnect.vercel.app or * for all)
FRONTEND_URL=*

# External AI Provider (Optional: Google Gemini API Key)
# If left empty, CareConnect uses its clinical rule heuristics model
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Server Port
PORT=5000
